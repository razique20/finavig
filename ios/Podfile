# Uncomment this line to define a global platform for your project
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

# Enable Google ML Kit pods on Apple Silicon iOS 26+ simulators: relabels the
# arm64 slice per build and strips EXCLUDED_ARCHS arm64 from pod xcconfigs.
#
# Resolve the script from the plugin's pub-cache path via
# .flutter-plugins-dependencies. Requiring it under .symlinks/plugins/... used
# to crash fresh checkouts: the symlinks are only created BY pod install, so
# the require ran before they existed and pod install never completed.
require 'json'

def find_mlkit_simulator_script
  plugins_file = File.expand_path('../.flutter-plugins-dependencies', __dir__)
  return nil unless File.exist?(plugins_file)

  plugin = JSON.parse(File.read(plugins_file))
               &.dig('plugins', 'ios')
               &.find { |p| p['name'] == 'google_mlkit_commons' }
  return nil if plugin.nil? || plugin['path'].nil?

  script = File.join(plugin['path'], 'ios', 'scripts', 'apple_silicon_simulator')
  File.exist?("#{script}.rb") ? script : nil
rescue StandardError
  nil
end

mlkit_simulator_script = find_mlkit_simulator_script
if mlkit_simulator_script
  require File.expand_path(mlkit_simulator_script)
else
  Pod::UI.warn 'apple_silicon_simulator.rb not found — ML Kit arm64 simulator patch will be skipped'
end

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  if defined?(mlkit_apple_silicon_simulator_patch)
    mlkit_apple_silicon_simulator_patch(installer)
  else
    Pod::UI.warn 'Skipping ML Kit Apple Silicon simulator patch (script not loaded)'
  end
end
